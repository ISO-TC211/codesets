PREFIX : <https://def.isotc211.org/codeset/OffsetSourceType/>
PREFIX cs: <https://def.isotc211.org/codeset/OffsetSourceType>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:manufacturerSpecifications
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the values have been obtained from manufacturer's specifications"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "manufacturer specifications"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:measured
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the values have been measured"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "measured"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:publication
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the values have been obtained from a publication other than the manufacturer's specifications"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "publication"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "the type of source from which an offset vector has been obtained"@en ;
    skos:hasTopConcept
        :manufacturerSpecifications ,
        :measured ,
        :publication ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "Offset Source Type"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
