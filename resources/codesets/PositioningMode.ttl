PREFIX : <https://def.isotc211.org/codeset/PositioningMode/>
PREFIX cs: <https://def.isotc211.org/codeset/PositioningMode>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:absolute
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "position determined directly in the reference system by known parameters of the system"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "absolute"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:relative
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "position determined relative to another point used by the positioning system"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "relative"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "codes to designate the nature of the connection"@en ;
    skos:hasTopConcept
        :absolute ,
        :relative ;
    skos:prefLabel "Positioning Mode"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-03"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    skos:historyNote "Taken from 19116:2025" ;
.
