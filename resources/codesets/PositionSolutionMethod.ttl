PREFIX : <https://def.isotc211.org/codeset/PositionSolutionMethod/>
PREFIX cs: <https://def.isotc211.org/codeset/PositionSolutionMethod>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:caCode
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "GNSS coarse/acquisition code"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "C/A code"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:kinematicFloating
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "double - difference vector with floating integer part and antenna mobile during observation"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "kinematic floating"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:ppsCode
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "GNSS precise positioning service P or Y code"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "PPS code"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:staticFixed
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "double - difference vector with fixed integer part and antennas stationary during observation"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "static fixed"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:staticFloating
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "double - difference vector with floating integer part and antennas stationary during observation"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "static floating"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "codes to identify the method of positioning solution"@en ;
    skos:hasTopConcept
        :caCode ,
        :kinematicFloating ,
        :ppsCode ,
        :staticFixed ,
        :staticFloating ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "Position Solution Method"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
