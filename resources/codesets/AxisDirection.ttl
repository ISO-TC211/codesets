PREFIX : <https://def.isotc211.org/codeset/AxisDirection/>
PREFIX cs: <https://def.isotc211.org/codeset/AxisDirection>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:future
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Axis positive direction is towards the future"@en ;
    skos:historyNote "Originally presented in the ISO 19136-1:2020 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "future"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:past
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Axis positive direction is towards the past"@en ;
    skos:historyNote "Originally presented in the ISO 19136-1:2020 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "past"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19136-1-2020> ;
    skos:definition "The direction of positive increase in the coordinate value for a coordinate system axis"@en ;
    skos:hasTopConcept
        :future ,
        :past ;
    skos:historyNote "Taken from 19136-1:2020" ;
    skos:prefLabel "Axis Direction"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
