PREFIX : <https://def.isotc211.org/codeset/RelativePlacement/>
PREFIX cs: <https://def.isotc211.org/codeset/RelativePlacement>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:geometry
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "relative to the coordinate reference system of the containing symbol component within which the current component is being placed"@en ;
    skos:historyNote "Originally presented in the ISO 19117:2012 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "geometry"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:notApplicable
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "not applicable"@en ;
    skos:historyNote "Originally presented in the ISO 19117:2012 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "not applicable"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:portrayal
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "relative to the coordinate reference system of the portrayal"@en ;
    skos:historyNote "Originally presented in the ISO 19117:2012 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "portrayal"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19117-2012> ;
    skos:definition "Names the possible relative placements of a symbol component, in particular point symbols. A placement can either be relative to the coordinate reference system of the portrayal or relative to the coordinate reference system of the containing symbol component within which the current component is being placed"@en ;
    skos:hasTopConcept
        :geometry ,
        :notApplicable ,
        :portrayal ;
    skos:historyNote "Taken from 19117:2012" ;
    skos:prefLabel "Relative Placement"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-08"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
.
