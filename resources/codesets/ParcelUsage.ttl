PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:factory
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "factory"@en ;
    skos:historyNote "Originally presented in the ISO 19136-1:2020 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "factory"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:offices
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "offices"@en ;
    skos:historyNote "Originally presented in the ISO 19136-1:2020 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "offices"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:residential
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "residential"@en ;
    skos:historyNote "Originally presented in the ISO 19136-1:2020 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "residential"@en ;
    skos:topConceptOf cs: ;
