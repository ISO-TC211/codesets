PREFIX : <https://def.isotc211.org/codeset/DOPType/>
PREFIX cs: <https://def.isotc211.org/codeset/DOPType>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:GDOP
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "geometric dilution of precision"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GDOP"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:HDOP
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "horizontal dilution of precision"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "HDOP"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PDOP
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "positional dilution of precision"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "PDOP"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:TDOP
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "time dilution of precision"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "TDOP"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:VDOP
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "vertical dilution of precision"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "VDOP"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "types of dilution of precision"@en ;
    skos:hasTopConcept
        :GDOP ,
        :HDOP ,
        :PDOP ,
        :TDOP ,
        :VDOP ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "DOP Type"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
