cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "capabilities of a positioning service"@en ;
    skos:hasTopConcept
        :attitudeData ,
        :attitudeQuality ,
        :motionData ,
        :motionQuality ,
        :positionData ,
        :positionQuality ,
        :rawMeasurementData ,
        :rotationData ,
        :rotationQuality ,
        :technologySpecificData ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "System Capability"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-08"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
.
