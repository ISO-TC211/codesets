PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:attitudeData
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the service is capable of providing altitude data"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "attitude data"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

