PREFIX : <https://def.isotc211.org/codeset/CorrectionMethod/>
PREFIX cs: <https://def.isotc211.org/codeset/CorrectionMethod>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:DGPS
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "differential GPS correction"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "DGPS"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:preciseEphemeris
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "precise ephemeris"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Precise Ephemeris"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:preciseEphemerisWithClockCorrection
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "precise ephemeris with clock correction"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Precise Ephemeris With Clock Correction"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "codes to identify the correction method"@en ;
    skos:hasTopConcept
        :DGPS ,
        :preciseEphemeris ,
        :preciseEphemerisWithClockCorrection ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "Correction Method"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
