cs:
    a skos:ConceptScheme ;
    skos:changeNote """2026-07: Added Model Packages, semi-auto-generated from XMI files
    
2025-11: Created to allow derivation of codelists from standards

2026-07: Added Code Sets as a result of feedback from Countries via CIB N 6268"""@en ;
    skos:definition "A code set of ISO/TC211 Standards"@en ;
    skos:hasTopConcept
        std:ISO19103-2015 ,
        std:ISO19103-2024 ,
        std:ISO19115-1-2014 ,
        std:ISO19115-1-2027 ,
        std:ISO19115-2003 ,
        std:ISO19116-2025 ,
        std:ISO19117-2012 ,
        std:ISO19126-2009 ,
        std:ISO19126-2021 ,
        std:ISO19135-1-2014 ,
        std:ISO19135-1-2015 ,
        std:ISO19135-2005 ,
        std:ISO19136-1-2020 ,
        std:ISO19143-2010 ,
        std:ISO19157-1-2023 ,
        std:ISO19157-2013 ,
        std:ISO19160-1-2015 ,
        std:ISO19178-1-2025 ,
        std:ISOawi-19115-1 ,
        std:ISOtc-19103-2005 ;
    skos:prefLabel "ISO/TC211 Standards"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2025-11-14"^^xsd:date ;
    schema:dateIssued "2025-11-19"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
.
