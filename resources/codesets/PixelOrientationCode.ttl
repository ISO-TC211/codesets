PREFIX : <https://def.isotc211.org/codeset/PixelOrientationCode/>
PREFIX cs: <https://def.isotc211.org/codeset/PixelOrientationCode>
PREFIX mpkg: <https://def.isotc211.org/package/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:centre
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "point halfway between the lower left and the upper right of the pixel"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2026 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "centre"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:lower-left
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the corner in the pixel closest to the origin of the SRS; if two are at the same distance from the origin, the one with the smallest x-value"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2026 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "lower left"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:lower-right
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "next corner counterclockwise from the lower left"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2026 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "lower right"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:upper-left
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "next corner counterclockwise from the upper right"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2026 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "upper left"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:upper-right
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "next corner counterclockwise from the lower right"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2026 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "upper right"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19115-1-2027> ;
    skos:definition "point in a pixel corresponding to the Earth location of the pixel"@en ;
    skos:hasTopConcept
        :centre ,
        :lower-left ,
        :lower-right ,
        :upper-left ,
        :upper-right ;
    skos:historyNote "This version of this codeset was produced for the 2025 update of the 19115 standard" ;
    skos:prefLabel "Pixel Orientation Code"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-01"^^xsd:date ;
    schema:dateIssued "2026-07-02"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf
        <https://def.isotc211.org/codesets> ,
        mpkg:SpatialRepresentationInformation ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
