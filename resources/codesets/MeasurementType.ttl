PREFIX : <https://def.isotc211.org/codeset/MeasurementType/>
PREFIX cs: <https://def.isotc211.org/codeset/MeasurementType>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:motion
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "this mode of operation reports motion"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "motion"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:orientation
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "this mode of operation reports orientation"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "orientation"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:position
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "this mode of operation reports position"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "position"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:rotation
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "this mode of operation reports rotation"@en ;
    skos:historyNote "Originally presented in the ISO 19116:2025 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "rotation"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19116-2025> ;
    skos:definition "identify the types of measurements provided by a positioning service"@en ;
    skos:hasTopConcept
        :motion ,
        :orientation ,
        :position ,
        :rotation ;
    skos:historyNote "Taken from 19116:2025" ;
    skos:prefLabel "Measurement Type"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-09"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    schema:version "1" ;
.
