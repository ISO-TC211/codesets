PREFIX : <https://def.isotc211.org/codeset/ParameterDirection/>
PREFIX cs: <https://def.isotc211.org/codeset/ParameterDirection>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:in
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the parameter is an input parameter to the service instance"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2014 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "in"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:out
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the parameter is an output parameter to the service instance"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2014 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "out"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:in-out
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "the parameter is both an input and output parameter to the service instance"@en ;
    skos:historyNote "Originally presented in the ISO 19115-1:2014 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "in/out"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.


cs:
    a skos:ConceptScheme ;
    skos:definition "class of information to which the referencing entity applies"@en ;
    skos:hasTopConcept
        :in ,
        :out ,
        :in-out ;
    skos:historyNote "This version of this codeset was produced for the 2025 update of the 19115 standard" ;
    skos:prefLabel "Parameter Direction"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-01"^^xsd:date ;
    schema:dateIssued "2026-07-02"^^xsd:date ;
    schema:dateModified "2026-07-02"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
.
