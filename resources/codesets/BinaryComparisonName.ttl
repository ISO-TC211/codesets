PREFIX : <https://def.isotc211.org/codeset/BinaryComparisonName/>
PREFIX cs: <https://def.isotc211.org/codeset/BinaryComparisonName>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:PropertyIsEqualTo
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Equal To"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Equal To"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PropertyIsGreaterThan
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Greater Than"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Greater Than"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PropertyIsGreaterThanOrEqualTo
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Greater Than Or Equal To"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Greater Than Or Equal To"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PropertyIsLessThan
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Less Than"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Less Than"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PropertyIsLessThanOrEqualTo
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Less Than Or Equal To"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Less Than Or Equal To"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

:PropertyIsNotEqualTo
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Property Is Not Equal To"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Property Is Not Equal To"@en ;
