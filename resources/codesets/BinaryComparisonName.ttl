cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19143-2010> ;
    skos:definition "A comparison operator is used to form expressions that evaluate the mathematical comparison between two arguments. If the arguments satisfy the comparison then the expression evaluates to true. Otherwise the expression evaluates to false"@en ;
    skos:hasTopConcept
        :PropertyIsEqualTo ,
        :PropertyIsGreaterThan ,
        :PropertyIsGreaterThanOrEqualTo ,
        :PropertyIsLessThan ,
        :PropertyIsLessThanOrEqualTo ,
        :PropertyIsNotEqualTo ;
    skos:historyNote "Taken from 19143:2010" ;
    skos:prefLabel "Binary Comparison Name"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-08"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
.
