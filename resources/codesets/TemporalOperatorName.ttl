PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:After
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:exactMatch <https://def.isotc211.org/codeset/TemporalOperator/After> ;
    skos:definition "After"@en ;
    skos:historyNote "Originally presented in the ISO 19143:2010 standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "After"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

