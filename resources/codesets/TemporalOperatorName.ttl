cs:
    a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://def.isotc211.org/codeset/standards/iso-19143-2010> ;
    skos:definition """A temporal operator (see Figure 7) determines whether its time arguments satisfy the stated temporal relationship. The operator evaluates to true if the temporal relationship is satisfied. Otherwise, the operator evaluates to false

The temporal operators are mapped to to the set of temporal operators defined in ISO 19108 per Concept with skos:exactMatch where appropriate"""@en ;
    skos:hasTopConcept
        :After ,
        :Before ,
        :Begins ,
        :BegunBy ,
        :TContains ,
        :During ,
        :TEquals ,
        :TOverlaps ,
        :Meets ,
        :OverlappedBy ,
        :MetBy ,
        :EndedBy ,
        :AnyInteracts ;
    skos:prefLabel "Temporal Operator Name"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-07-03"^^xsd:date ;
    schema:dateIssued "2026-07-03"^^xsd:date ;
    schema:dateModified "2026-07-03"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    skos:historyNote "Taken from 19143:2010" ;
.
