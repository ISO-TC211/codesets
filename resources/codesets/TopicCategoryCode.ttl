PREFIX : <https://def.isotc211.org/codeset/TopicCategoryCode/>
PREFIX cs: <https://def.isotc211.org/codeset/TopicCategoryCode>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
