PREFIX : <https://def.isotc211.org/codeset/{CONCEPTSCHEME-ID}/>
PREFIX cs: <https://def.isotc211.org/codeset/{CONCEPTSCHEME-ID}>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX status: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>


:{CONCEPT-IRI}
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "{CONCEPT-DEFINITION}"@en ;
    skos:historyNote "Originally presented in the ISO {STANDARD-ID} standard codelist, reproduced unchanged here"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "{CONCEPT-PREFLABEL}"@en ;
    skos:topConceptOf cs: ;
    schema:status status:original ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition "{CONCEPTSCHEME-DEFINITION}"@en ;
    skos:hasTopConcept {TOP-CONCEPTS} ;
    skos:prefLabel "{CONCEPTSCHEME-PREFLABEL}"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "{DATE-CREATED}"^^xsd:date ;
    schema:dateIssued "{DATE-ISSUED}"^^xsd:date ;
    schema:dateModified "{DATE-MODIFIED}"^^xsd:date ;
    schema:isPartOf <https://def.isotc211.org/codesets> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    schema:status status:experimental ;
    skos:historyNote "Taken from {STANDARD-ID}" ;
.
